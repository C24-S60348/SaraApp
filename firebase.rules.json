{
  "rules": {
    ".read": false,
    ".write": false,
    "petRooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/) && newData.hasChildren()"
      }
    },
    "zumaRooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/) && newData.hasChildren()"
      }
    },
    "tanamRooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/) && newData.hasChildren()"
      }
    }
  }
}